---
import Layout from '../layouts/Layout.astro';
import { portfolio, projects } from '../data/portfolio';
import '../styles/portfolio.css';
---

<Layout>
	<div class="page-shell">
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="wordmark" href="#inicio" aria-label={`${portfolio.name}, inicio`}>
				<img src="/images/logo.png" alt="Logo" class="wordmark-logo" />
				<span>{portfolio.name}</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#proyectos">Proyectos</a>
				<a href="#sobre-mi">Sobre mí</a>
				<a class="nav-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
			</nav>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="status-dot"></span>{portfolio.role}</p>
					<h1 id="hero-title">Código con propósito.<br /><em>Soluciones reales.</em></h1>
					<p class="hero-description">{portfolio.intro}</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a>
						<a class="text-link" href="#sobre-mi">Conóceme <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-note"><span>01 — 03</span><span>Portafolio seleccionado</span></div>
				</div>
				<div class="hero-visual">
					<img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1400&q=90" alt="Espacio de trabajo con portátil y herramientas de desarrollo" fetchpriority="high" />
					<div class="visual-caption"><span>Desarrollo de software</span><span>Est. 2026</span></div>
					<div class="visual-index" aria-hidden="true">Nº<br />01</div>
				</div>
			</section>

			<div class="discipline-strip" aria-label="Áreas de trabajo">
					<span>Desarrollo web</span><i aria-hidden="true">✳</i>
					<span>Backend y API</span><i aria-hidden="true">✳</i>
					<span>Bases de datos</span><i aria-hidden="true">✳</i>
					<span>Soluciones tecnológicas</span>
			</div>

			<section class="work-section section-wrap" id="proyectos" aria-labelledby="work-title">
				<div class="section-heading">
					<div><p class="eyebrow">Proyectos personales y académicos</p><h2 id="work-title">Trabajo <em>destacado</em></h2></div>
					<p class="section-aside">Desarrollo · Tecnología<br />Aprendizaje continuo</p>
				</div>
				<div class="project-grid">
					{projects.map((project) => (
						<article class={`project-card ${project.color}`}>
							<div class="project-image">
								<img src={project.image} alt={project.alt} loading="lazy" />
								<span class="project-number">{project.number}</span>
								<span class="concept-label">{project.status}</span>
							</div>
							<div class="project-info">
								<div><h3>{project.name}</h3><p>{project.category}</p></div>
								<span class="project-year">{project.year}</span>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="about-section" id="sobre-mi" aria-labelledby="about-title">
				<div class="about-inner section-wrap">
					<p class="eyebrow">Un poco sobre mí</p>
					<div class="about-content">
						<h2 id="about-title">Pienso en sistemas.<br />Construyo con <em>código.</em></h2>
						<div class="about-copy">
							<p>{portfolio.about}</p>
							<a class="text-link" href="#contacto">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a>
						</div>
					</div>
					<div class="skill-list" aria-label="Servicios">
						{portfolio.services.map((service) => <span>{service}</span>)}
					</div>
				</div>
			</section>

			<section class="contact-section section-wrap" id="contacto" aria-labelledby="contact-title">
				<p class="eyebrow">¿Tienes algo en mente?</p>
				<div class="contact-row">
					<h2 id="contact-title">Hagámoslo <em>real.</em></h2>
					<a class="contact-link" href={`mailto:${portfolio.email}`}>{portfolio.email} <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<span>© <span data-current-year>2026</span> {portfolio.name}</span>
			<span>Diseñado con intención, en internet.</span>
			<a href="#inicio">Volver arriba ↑</a>
		</footer>
	</div>
</Layout>

<script>
	import '../scripts/site';
</script>
