---
import { competencias, experiencia } from '../data/perfil';

/** Casillas del collage. Cada una va mostrando una foto distinta del grupo. */
const TILES = [0, 1, 2, 3];
---

<section class="section" id="trayectoria">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">FORMACIÓN</p>
      <h2 class="section__title">Trayectoria</h2>
      <p class="section__subtitle">
        Técnico en Desarrollo de Software e Ingeniería de Sistemas en curso.
      </p>
    </div>

    <ol class="exp-list" data-timeline>
      {
        experiencia.map((item, indice) => (
          <li
            class:list={[
              'exp-item',
              'reveal',
              {
                'exp-item--technician':
                  item.puesto === 'Técnico en Desarrollo de Software',
                'exp-item--collage': Boolean(item.galeria?.length),
              },
            ]}
          >
            <p class="exp-period">{item.periodo}</p>
            <div class="exp-detail">
              <h3>{item.puesto}</h3>
              <p class="exp-company">{item.empresa}</p>
              <p class="exp-summary">{item.resumen}</p>
              <ul class="exp-achievements">
                {item.logros.map((logro) => (
                  <li>{logro}</li>
                ))}
              </ul>
              <ul class="tag-list">
                {item.stack.map((tech) => (
                  <li class="tag">{tech}</li>
                ))}
              </ul>
              {item.puesto === 'Técnico en Desarrollo de Software' && (
                <aside class="exp-project" aria-label="Proyecto final del SENA">
                  <span class="exp-project__label">Proyecto final · SENA</span>
                  <strong class="exp-project__name">Finovateh</strong>
                </aside>
              )}
            </div>
            {item.puesto === 'Técnico en Desarrollo de Software' && (
              <div
                class="credential-gallery"
                data-credential-gallery
                aria-label="Fotos de la graduación técnica"
              >
                <div class="credential-gallery__slides">
                  <figure
                    class="credential-slide is-active"
                    data-credential-slide
                    aria-hidden="false"
                  >
                    <div class="credential-slot credential-slot--diploma">
                      <span class="credential-slot__index">01 / 02</span>
                      <svg
                        class="credential-slot__icon"
                        viewBox="0 0 48 48"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect
                          x="9"
                          y="6"
                          width="30"
                          height="36"
                          rx="2"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                        <path
                          d="M16 16h16M16 22h16M16 28h8"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        />
                        <circle
                          cx="31"
                          cy="33"
                          r="4"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                      </svg>
                      <span class="credential-slot__title">Diploma técnico</span>
                      <code class="credential-slot__path">
                        public/img/diploma-tecnico.jpg
                      </code>
                    </div>
                    <figcaption class="credential-caption">
                      <span>Certificación</span>
                      <span>Diploma</span>
                    </figcaption>
                  </figure>

                  <figure
                    class="credential-slide"
                    data-credential-slide
                    aria-hidden="true"
                  >
                    <div class="credential-slot credential-slot--ceremony">
                      <span class="credential-slot__index">02 / 02</span>
                      <svg
                        class="credential-slot__icon"
                        viewBox="0 0 48 48"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect
                          x="5"
                          y="10"
                          width="38"
                          height="28"
                          rx="2"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                        <circle
                          cx="24"
                          cy="21"
                          r="5"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                        <path
                          d="M14 34c1.8-4 5.1-6 10-6s8.2 2 10 6"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                        />
                      </svg>
                      <span class="credential-slot__title">Entrega del diploma</span>
                      <code class="credential-slot__path">
                        public/img/entrega-diploma.jpg
                      </code>
                    </div>
                    <figcaption class="credential-caption">
                      <span>El momento</span>
                      <span>Graduación</span>
                    </figcaption>
                  </figure>
                </div>
              </div>
            )}

            {item.galeria?.length ? (
              <div class="rob-collage" data-rob-collage>
                <div
                  class="rob-collage__grid"
                  role="img"
                  aria-label="Collage de fotos del trabajo en robótica"
                >
                  {TILES.map((tile) => (
                    <div class="rob-collage__tile">
                      {(item.galeria ?? []).map((foto, indice) => (
                        <div
                          class:list={[
                            'rob-collage__layer',
                            { 'is-active': indice === tile },
                          ]}
                        >
                          <div class="rob-slot">
                            <span class="rob-slot__index">
                              {String(indice + 1).padStart(2, '0')}
                            </span>
                            <svg
                              class="rob-slot__icon"
                              viewBox="0 0 48 48"
                              fill="none"
                              aria-hidden="true"
                            >
                              <rect
                                x="6"
                                y="12"
                                width="36"
                                height="24"
                                rx="2"
                                stroke="currentColor"
                                stroke-width="1.5"
                              />
                              <circle
                                cx="17"
                                cy="21"
                                r="3.5"
                                stroke="currentColor"
                                stroke-width="1.5"
                              />
                              <path
                                d="M11 33l8-7 6 5 5-4 7 6"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <code class="rob-slot__path">public/img/{foto}</code>
                          </div>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>

              <div class="exp-extra">
                <button
                  class="exp-toggle"
                  type="button"
                  data-exp-toggle
                  aria-expanded="false"
                  aria-controls={`panel-competencias-${indice}`}
                >
                  <span data-exp-toggle-label>
                    Ver experiencia en competencias
                  </span>
                  <svg
                    class="exp-toggle__icon"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 6l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>

                <div
                  class="exp-extra__panel"
                  id={`panel-competencias-${indice}`}
                  hidden
                >
                  {
                    /* Todas las tarjetas llevan las mismas cuatro líneas, así
                       que se avisa de lo que falte en vez de partirla. */
                    competencias.length ? (
                      <ul class="comp-list">
                        {competencias.map((comp) => (
                          <li class="comp-item">
                            <p class="comp-item__periodo">{comp.periodo}</p>
                            <div class="comp-item__body">
                              <h3>{comp.titulo}</h3>
                              <p class="comp-item__evento">
                                {comp.evento ?? 'Torneo'}
                              </p>
                              <p class="comp-item__resultado">
                                {comp.resultado ?? 'Puesto por confirmar'}
                              </p>
                              <p class="comp-item__lugar">
                                {comp.lugar ?? 'Ciudad por confirmar'}
                              </p>
                            </div>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="exp-extra__vacio">
                        Falta esta información. Agrégala en{' '}
                        <code>src/data/perfil.ts</code>, en la lista{' '}
                        <code>competencias</code>, y saldría aquí
                        automáticamente.
                      </p>
                    )
                  }
                </div>
              </div>
            ) : null}
          </li>
        ))
      }
    </ol>
  </div>
</section>
