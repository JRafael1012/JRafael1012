---
import { proyectos } from '../data/perfil';
import ProyectoCard from './ProyectoCard.astro';

/**
 * Sección "Proyectos" — la lista completa.
 *
 * Aquí van TODOS los proyectos, los destacados incluidos: los 3 mejores ya
 * tienen su propia sección más arriba y aquí se ven en igualdad con el
 * resto. La tarjeta es la misma (`ProyectoCard.astro`), sin `destacada`, así
 * que sale en la rejilla y no en ancho completo.
 *
 * El usuario pidió entre 5 y 8. Ahora mismo hay 3 confirmados, que es lo
 * único que hay; los que falten se añaden en `proyectos` y aparecem solos.
 */
---

<section class="section" id="proyectos">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">PROYECTOS</p>
      <h2 class="section__title">Todos los proyectos</h2>
      <p class="section__subtitle">
        Cada uno con su problema, su stack y lo que aporté.
      </p>
    </div>

    <div class="card-grid">
      {
        proyectos.map((proyecto, i) => (
          <ProyectoCard proyecto={proyecto} indice={i + 1} />
        ))
      }
    </div>
  </div>
</section>